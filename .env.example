# Todas opcionais — o app roda sem nenhuma delas.

# Caminho do arquivo SQLite (padrão: data/healthscore.db)
# HEALTHSCORE_DB=/srv/healthscore/data/healthscore.db

# Dia fixo do ritual de preenchimento do GT: 0=domingo … 5=sexta (padrão), 6=sábado
# HEALTHSCORE_RITUAL_DAY=5

# Protege POST /api/recompute (header x-recompute-token). Sem valor, a rota fica aberta.
# RECOMPUTE_TOKEN=troque-por-um-segredo

# Lista do ClickUp onde o botão "Abrir tarefa" cai, já com título e descrição preenchidos.
# NEXT_PUBLIC_CLICKUP_LIST_URL=https://app.clickup.com/1234567/v/li/9876543
