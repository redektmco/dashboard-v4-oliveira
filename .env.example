# Postgres do Neon, provisionado pelo Marketplace da Vercel.
# Local: rode `vercel env pull .env.local --yes` — não copie a senha à mão.
DATABASE_URL=

# Protege POST /api/recompute (header x-recompute-token).
# O cron da Vercel usa Authorization: Bearer $CRON_SECRET; deixe em branco
# para manter a rota aberta ao cron.
# RECOMPUTE_TOKEN=

# Dia fixo do ritual de preenchimento do GT: 0=domingo … 5=sexta (padrão).
# HEALTHSCORE_RITUAL_DAY=5

# Lista do ClickUp onde o botão "Abrir tarefa" cai, já preenchido.
# NEXT_PUBLIC_CLICKUP_LIST_URL=

# Token do usuário de sistema da unidade no Business Manager (escopo ads_read,
# acesso a todas as BMs). Liga a sincronização do Meta Ads. Nunca commite.
# META_ACCESS_TOKEN=
# META_GRAPH_VERSION=v23.0

# Google Ads (campanhas do Google). Service account + developer token da MCC.
# Nunca commite. A chave vai em uma linha, com \n literal (como a Vercel guarda).
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_SA_EMAIL=
# GOOGLE_SA_PRIVATE_KEY=
# (alternativa às duas acima: o JSON inteiro do service account em GOOGLE_SA_JSON)
# ID da MCC por onde as contas dos clientes são acessadas e listadas, só dígitos
# (ex.: 124-444-3600 -> 1244443600). Necessário para listar as contas no painel.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# E-mail do usuário do Workspace a representar, se usar delegação de domínio (opcional).
# GOOGLE_ADS_IMPERSONATE=
# GOOGLE_ADS_API_VERSION=v23
