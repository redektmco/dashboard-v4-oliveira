{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "slides/**",
              "ui_kits/bi-desktop/**",
              "ui_kits/bi-mobile/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Montserrat|Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Montserrat, Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClientDetail'] > JSXAttribute > JSXIdentifier[name!=/^(?:client|onBack|key|ref|className|style|children)$/]",
        "message": "<ClientDetail> doesn't accept that prop. Declared props: client, onBack."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClientDossie'] > JSXAttribute > JSXIdentifier[name!=/^(?:client|key|ref|className|style|children)$/]",
        "message": "<ClientDossie> doesn't accept that prop. Declared props: client."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClientMeetings'] > JSXAttribute > JSXIdentifier[name!=/^(?:client|key|ref|className|style|children)$/]",
        "message": "<ClientMeetings> doesn't accept that prop. Declared props: client."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClientTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:onOpen|fullPage|key|ref|className|style|children)$/]",
        "message": "<ClientTable> doesn't accept that prop. Declared props: onOpen, fullPage."
      },
      {
        "selector": "JSXOpeningElement[name.name='Identity'] > JSXAttribute > JSXIdentifier[name!=/^(?:onReady|key|ref|className|style|children)$/]",
        "message": "<Identity> doesn't accept that prop. Declared props: onReady."
      },
      {
        "selector": "JSXOpeningElement[name.name='Overview'] > JSXAttribute > JSXIdentifier[name!=/^(?:onOpenClient|key|ref|className|style|children)$/]",
        "message": "<Overview> doesn't accept that prop. Declared props: onOpenClient."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sidebar'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|onNavigate|counts|key|ref|className|style|children)$/]",
        "message": "<Sidebar> doesn't accept that prop. Declared props: current, onNavigate, counts."
      },
      {
        "selector": "JSXOpeningElement[name.name='Topbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:crumbs|period|onSearch|query|key|ref|className|style|children)$/]",
        "message": "<Topbar> doesn't accept that prop. Declared props: crumbs, period, onSearch, query."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
